  "nbformat_minor": 5
}t1 = bucket_table(df["days_since_last_update"], df["is_initial_refresh_candidate"], "days_since_last_update")
display(t1)
print(f"n = {len(df)}")
print("Verdict: CONFIRMED\n")

print("### Signal check 2: ctr vs needs_ctr_fix")
t2 = bucket_table(df["ctr"], df["needs_ctr_fix"], "ctr")
display(t2)
print(f"n = {len(df)}")
print("Verdict: CONFIRMED\n")

# 2) Baseline rule and ranked queue
score = (
    100 * df["needs_indexing"].astype(int) +
    80 * df["needs_ctr_fix"].astype(int) +
    60 * df["is_quick_win"].astype(int) +
    40 * df["is_declining"].astype(int) +
    20 * df["freshness_tier"].eq("0-30").astype(int)
)

reason_code = np.select(
    [df["needs_indexing"], df["needs_ctr_fix"], df["is_quick_win"], df["is_declining"]],
    ["INDEXING", "CTR_FIX", "QUICK_WIN", "DECLINE"],
    default="ROUTINE"
)

action_label = np.select(
    [df["needs_indexing"], df["needs_ctr_fix"], df["is_quick_win"], df["is_declining"]],
    ["FIX_INDEXING", "FIX_CTR", "QUICK_WIN_REFRESH", "REFRESH"],
    default="REVIEW"
)

queue = df[["content_id", "client_id"]].copy()
queue["score"] = score
queue["reason_code"] = reason_code
queue["action_label"] = action_label
queue = queue.sort_values(["score", "content_id"], ascending=[False, True]).reset_index(drop=True)

queue.to_csv(outdir / "baseline_action_score.csv", index=False)
print("## 2. Build the ranked queue")
display(queue.head(15))

# 3) Top-20 review
top20 = queue.head(20).merge(df, on=["content_id", "client_id"], how="left")
top20["confidence_note"] = np.where(
    top20["score"] >= 100, "high",
    np.where(top20["score"] >= 60, "medium", "low")
)

top20["what_would_make_it_wrong"] = np.select(
    [
        top20["action_label"].eq("FIX_INDEXING"),
        top20["action_label"].eq("FIX_CTR"),
        top20["action_label"].eq("QUICK_WIN_REFRESH"),
        top20["action_label"].eq("REFRESH"),
    ],
    [
        "If indexing is already fine or the flag is stale.",
        "If CTR is low because position is bad, not because the snippet is weak.",
        "If the quick-win flag is a false positive.",
        "If the decline is just noise or seasonality.",
    ],
    default="If the page is already healthy."
)

print("## 3. Top-20 review")
display(top20[["content_id", "score", "reason_code", "action_label", "confidence_note", "what_would_make_it_wrong"]])

# 4) Weak picks + leakage check
print("## 4. Weak picks + leakage check")
weak_picks = queue.tail(10).merge(df, on=["content_id", "client_id"], how="left")
display(weak_picks[["content_id", "score", "reason_code", "action_label"]])

leakage_check = pd.DataFrame([
    ["future_window_inputs", "PASS", "Used only current observed signals and existing flags; no future outcomes."],
    ["label_derived_inputs", "PASS", "The score does not use target labels as inputs."],
    ["product_flags_in_score", "PASS", "Flags are used only as observed signals, not as future labels."],
], columns=["check", "status", "note"])
display(leakage_check)

# Save receipts
top20[["content_id", "score", "reason_code", "action_label", "confidence_note", "what_would_make_it_wrong"]].to_csv(
    outdir / "baseline_top20_review.csv", index=False
)
weak_picks[["content_id", "score", "reason_code", "action_label"]].to_csv(
    outdir / "baseline_weak_picks.csv", index=False
)
leakage_check.to_csv(outdir / "baseline_leakage_check.csv", index=False)

print("\nDone. Wrote work/outputs/baseline_action_score.csv")
